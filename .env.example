# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OpenRouter API Key for the AI Council Chamber models
# This is now handled securely by the server proxy
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"

# Firebase Client Configuration (e.g. for Railway or external deployments)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional Firestore database ID (defaults to (default) if omitted or when changing projects)
VITE_FIREBASE_DATABASE_ID=

# Server Firebase Admin Configuration (defaults to VITE_FIREBASE_PROJECT_ID if omitted)
FIREBASE_PROJECT_ID=

# Server Owner Authentication
# Set OWNER_UID or OWNER_EMAIL to lock down server API routes to a specific Firebase user
OWNER_UID=
OWNER_EMAIL=
# Optional access secret fallback for non-Firebase headless clients
COUNCIL_ACCESS_SECRET=

# Railway Deployment Variables
# PORT: Injected automatically by Railway (e.g. 4567 or 8080). Falls back to 3000 locally.
PORT=3000
# Railway builder Node.js 24 runtime selectors
NIXPACKS_NODE_VERSION=24
RAILPACK_NODE_VERSION=24

