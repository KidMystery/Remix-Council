-rules_version = '2';
-
-service cloud.firestore {
-  match /databases/{database}/documents {
-
-    // --- Helper Functions ---
-    function isSignedIn() {
-      return request.auth != null;
-    }
-
-    function isOwner(userId) {
-      return isSignedIn() && request.auth.uid == userId;
-    }
-
-    function isValidId(id) {
-      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
-    }
-
-    function incoming() {
-      return request.resource.data;
-    }
-
-    function existing() {
-      return resource.data;
-    }
-
-    function isValidCouncilSession(data) {
-      return data.id is string && isValidId(data.id) &&
-             data.userId is string && isValidId(data.userId) && data.userId == request.auth.uid &&
-             data.title is string && data.title.size() <= 500 &&
-             data.createdAt is number &&
-             data.updatedAt is number &&
-             (!('rounds' in data) || (data.rounds is list && data.rounds.size() <= 50)) &&
-             (!('settings' in data) || data.settings is map) &&
-             (!('shareToken' in data) || (data.shareToken is string && data.shareToken.size() <= 128)) &&
-             (!('presetId' in data) || (data.presetId is string && data.presetId.size() <= 64)) &&
-             (!('personas' in data) || (data.personas is list && data.personas.size() <= 20)) &&
-             (!('synthesizer' in data) || data.synthesizer is map) &&
-             (!('customModels' in data) || data.customModels is map) &&
-             (!('synthesizerModel' in data) || (data.synthesizerModel is string && data.synthesizerModel.size() <= 120)) &&
-             (!('attachedFiles' in data) || (data.attachedFiles is list && data.attachedFiles.size() <= 100));
-    }
-
-    function isValidUserSettings(data) {
-      return data.updatedAt is number &&
-             (!('settings' in data) || data.settings is map) &&
-             (!('personas' in data) || (data.personas is list && data.personas.size() <= 20)) &&
-             (!('synthesizer' in data) || data.synthesizer is map);
-    }
-
-    // Default deny all unmapped documents
-    match /{document=**} {
-      allow read, write: if false;
-    }
-
-    // Secure user space
-    match /users/{userId} {
-      allow get: if isOwner(userId) && isValidId(userId);
-
-      match /sessions/{sessionId} {
-        allow get, delete: if isOwner(userId) && isValidId(userId) && isValidId(sessionId);
-        allow list: if isOwner(userId) && isValidId(userId);
-        allow create: if isOwner(userId) &&
-                         isValidId(userId) &&
-                         isValidId(sessionId) &&
-                         incoming().id == sessionId &&
-                         incoming().userId == userId &&
-                         isValidCouncilSession(incoming());
-        allow update: if isOwner(userId) &&
-                         isValidId(userId) &&
-                         isValidId(sessionId) &&
-                         isValidCouncilSession(incoming()) &&
-                         incoming().id == existing().id &&
-                         incoming().userId == existing().userId &&
-                         incoming().createdAt == existing().createdAt;
-      }
-
-      match /settings/{docId} {
-        allow get: if isOwner(userId) && isValidId(userId) && isValidId(docId);
-        allow list: if isOwner(userId) && isValidId(userId);
-        allow create, update: if isOwner(userId) &&
-                                 isValidId(userId) &&
-                                 isValidId(docId) &&
-                                 isValidUserSettings(incoming());
-        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(docId);
-      }
-    }
-  }
-}
