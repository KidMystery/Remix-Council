# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# OpenRouter API Key for the AI Council Chamber models
# This is now handled securely by the server proxy
OPENROUTER_API_KEY="YOUR_OPENROUTER_API_KEY"

# Google OAuth Client ID for Google Drive session sync (Google Identity Services)
VITE_GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID

# Council Access Key: shared secret between the client and the server proxy.
# VITE_COUNCIL_ACCESS_KEY is embedded in the client bundle; COUNCIL_ACCESS_KEY
# is checked by the server. They must match.
COUNCIL_ACCESS_KEY=your-long-random-string
VITE_COUNCIL_ACCESS_KEY=same-value

# Owner email gate: when set on the server, the money route (/api/council)
# only accepts requests verified as this Google account (via the Drive
# sign-in token). Leave unset for local dev (gate falls open).
OWNER_EMAIL=kda11deuce@gmail.com

# Rate limiting: max requests per minute per IP on /api/council (default 60).
RATE_LIMIT_PER_MINUTE=60

# Railway Deployment Variables
# PORT: Injected automatically by Railway (e.g. 4567 or 8080). Falls back to 3000 locally.
PORT=3000
# Railway builder Node.js 24 runtime selectors
NIXPACKS_NODE_VERSION=24
RAILPACK_NODE_VERSION=24
